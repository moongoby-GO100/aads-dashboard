#!/bin/bash
# aads-dashboard pre-commit
#
# 정본은 scripts/hooks/pre-commit, 설치본은 .git/hooks/pre-commit 이다.
# 저장소본만 고치면 게이트는 옛 코드로 돈다 — 고친 뒤 반드시:
#   cp scripts/hooks/{pre-commit,commit-msg} .git/hooks/
#
# 이 저장소는 Next.js 프런트엔드다. aads-server 의 pre-commit(파이썬 구문·ruff·
# Docker import·pytest)을 그대로 들고 오면 전부 헛돌거나 실패한다. 그래서 여기서는
# (1) 시크릿 유출 차단 (2) HOOK_VERIFIED 서명만 한다. 빌드 검증은 deploy.sh 가 한다.
set -u
RED='\033[0;31m'; GRN='\033[0;32m'; NC='\033[0m'
GIT_DIR=$(git rev-parse --git-dir 2>/dev/null)
HOOK_SIG="dashboard-precommit-$(date +%s)-$$"

sign_and_exit() { echo "$HOOK_SIG" > "$GIT_DIR/HOOK_VERIFIED"; exit 0; }

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED" ] && sign_and_exit

# ── 1. 시크릿 패턴 차단 (R-KEY) ──────────────────────────────────
# 위반하면 제공사가 키를 leaked 처리해 영구 비활성화한다. 되돌릴 수 없다.
PATTERNS=(
  'AIzaSy[a-zA-Z0-9_-]{20,}'
  'sk-ant-api[a-zA-Z0-9_-]{20,}'
  'sk-ant-oat[a-zA-Z0-9_-]{20,}'
  'sk-proj-[a-zA-Z0-9_-]{20,}'
  'ghp_[a-zA-Z0-9]{36}'
  'xox[baprs]-[a-zA-Z0-9-]{10,}'
)
FOUND=0
for f in $STAGED; do
  case "$f" in
    scripts/hooks/*) continue ;;   # 이 파일 자신의 패턴 목록은 검사 대상이 아니다
    *.png|*.jpg|*.jpeg|*.gif|*.ico|*.woff*|package-lock.json) continue ;;
  esac
  for p in "${PATTERNS[@]}"; do
    if git show ":$f" 2>/dev/null | grep -qE "$p"; then
      echo -e "${RED}[BLOCKED] 시크릿 패턴 감지: $f${NC}"
      FOUND=1
    fi
  done
done

# ── 2. .env 계열 스테이징 차단 ───────────────────────────────────
for f in $STAGED; do
  case "$(basename "$f")" in
    .env|.env.*|auth.json|credentials.json)
      echo -e "${RED}[BLOCKED] 시크릿 파일을 커밋하려 합니다: $f${NC}"
      echo "  .gitignore 에 추가하고 'git restore --staged $f' 하세요."
      FOUND=1
      ;;
  esac
done

if [ "$FOUND" -ne 0 ]; then
  echo ""
  echo -e "${RED}커밋 차단됨. 우회(--no-verify)하지 말고 원인을 고치세요 (R-COMMIT).${NC}"
  exit 1
fi

echo -e "${GRN}[pre-commit] 시크릿 검사 통과 ($(echo "$STAGED" | wc -l)개 파일)${NC}"
sign_and_exit
